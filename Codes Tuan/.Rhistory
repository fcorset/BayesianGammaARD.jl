# fonction ntrap : renvoie l'intégrale par la méthode des trapèzes
ntrap <- function(abs,ord){
# Cette fonction renvoie un vecteurde taille nc
# abscisse abs : vecteur de taille nl
# ordonnée ord : matrice de taille nl*nc
nl<- length(abs)
if (is.matrix(ord) == T){
nc <- nrow(ord)
res <- rowSums(diff(abs)*(ord[-length(ord)]+ord[-1])/2)
} else {
nc <- 1
res<- sum((matrix(1,ncol=1,nrow=nc)*diff(abs))*(ord[-length(ord)]+ord[-1])/2)
}
return res
}
