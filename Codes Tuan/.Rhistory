res <- rowSums((matrix(1,ncol=1,nrow=nc)*diff(abs))*(ord[,-rcol(ord)]+ord[,-1])/2)
} else {
nc <- 1
res <- sum(diff(abs)*(ord[-length(ord)]+ord[-1])/2)
}
return(res)
}
