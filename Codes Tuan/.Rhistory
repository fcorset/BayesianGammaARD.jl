Q1 <- ntrap(x.level[1:ind.L],t(mat.trans[1:ind.L,]) * matrix(1,nrow = n.level.y,ncol = ind.L) %*%pi(level.x[1:ind.L]))
Q1 <- ntrap(level.x[1:ind.L],t(mat.trans[1:ind.L,]) * matrix(1,nrow = n.level.y,ncol = ind.L) %*%pi(level.x[1:ind.L]))
# vecteur de l'état x
level.x <- seq(0,M+1,0.05)
n.level.x <-length(level.x)
ind.L <- which( level.x == L)
ind.M <- which( level.x == M)
level.y <- seq(0,M+1,0.05)
n.level.y <-length(level.y)
mat.trans <- matrix(0,ncol=n.level.y,nrow = n.level.x)
for(i in 1:(n.level.x-1)){
mat.trans[i,(i+1):n.level.y]<-dgamma(level.y[(i+1):n.level.y]-level.x[i],scale=b,shape = alpha*tau^beta)
}
Q1 <- ntrap(level.x[1:ind.L],t(mat.trans[1:ind.L,]) * matrix(1,nrow = n.level.y,ncol = ind.L) %*%pi(level.x[1:ind.L]))
mat.trans.rho <- matrix(0,ncol=n.level.y,nrow = n.level.x)
for(i in 1:(n.level.x-1)){
mat.trans[i,(i+1):n.level.y]<-dgamma(level.y[(i+1):n.level.y]-level.x[i],scale=b,shape = alpha*tau^beta)
mat.trans.rho[i,(i+1):n.level.y]<-dgamma(level.y[(i+1):n.level.y]-(1-rho)*level.x[i],scale=b,shape = alpha*tau^beta)
}
w<-dgamma(level.y,scale = b,shape=alpha*tau^beta)
w
level.y
w <- Q1+Q2+Q3
for(k in 1:K){
# Contribution à la première intégrale :
# Remplacer pi par la valeur ancienne de la loi stationnaire
Q1 <- ntrap(level.x[1:ind.L],t(mat.trans[1:ind.L,]) * matrix(1,nrow = n.level.y,ncol = ind.L) %*% w[level.x[1:ind.L]])
# Contribution à la deuxième intégrale :
# Remplacer pi par la valeur ancienne de la loi stationnaire
Q2 <- ntrap(level.x[(ind.L+1):ind.M],t(mat.trans.rho[(ind.L+1):ind.M,]) * matrix(1,nrow = n.level.y,ncol = ind.M-ind.L) %*% w[level.x[(ind.L+1):ind.M]])
# Contribution à la troisième intégrale :
# Remplacer pi par la valeur ancienne de la loi stationnaire
Q3 <- dgamma(level.y,scale=b,shape=alpha*tau^beta) * ntrap(level.x[(ind.M+1):n.level.y],w[level.x[(ind.M+1):n.level.y]])
w <- Q1+Q2+Q3
}
K<-20
w<-dgamma(level.y,scale = b,shape=alpha*tau^beta)
for(k in 1:K){
# Contribution à la première intégrale :
# Remplacer pi par la valeur ancienne de la loi stationnaire
Q1 <- ntrap(level.x[1:ind.L],t(mat.trans[1:ind.L,]) * matrix(1,nrow = n.level.y,ncol = ind.L) %*% w[level.x[1:ind.L]])
# Contribution à la deuxième intégrale :
# Remplacer pi par la valeur ancienne de la loi stationnaire
Q2 <- ntrap(level.x[(ind.L+1):ind.M],t(mat.trans.rho[(ind.L+1):ind.M,]) * matrix(1,nrow = n.level.y,ncol = ind.M-ind.L) %*% w[level.x[(ind.L+1):ind.M]])
# Contribution à la troisième intégrale :
# Remplacer pi par la valeur ancienne de la loi stationnaire
Q3 <- dgamma(level.y,scale=b,shape=alpha*tau^beta) * ntrap(level.x[(ind.M+1):n.level.y],w[level.x[(ind.M+1):n.level.y]])
w <- Q1+Q2+Q3
}
