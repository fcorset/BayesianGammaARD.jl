n <- length(x)-1
X <- seq(from = 0, by = h, to = x[1])
p <- length(X)
# x[1] non divisible par h ... on rajoute un "bout de pas"
if ((x[1]>h) & (X[p[1]]!=x[1])) {
p[1] <- p[1]+1
X[p[1]] <- x[1]
}
for (i in 2:(n+1)) {
# car on va jusqu'a L
if (x[i] >= x[i-1]+h) {
X <- c(X, seq(from = x[i-1]+h, by = h, to = x[i]))
p <- length(X)
# x(i)-x(i-1) non divisible par h ... on rajoute un "bout de pas"
if (X[p[i]]!=x[i]) {
p[i] <- p[i]+1
X[p[i]] <- x[i]
}
else if (x[i]>x[i-1]) {
p[i] <- p[i-1]+1
X[p[i]] <- x[i]
} else {
p[i] <- p[i-1]
}
}
}
