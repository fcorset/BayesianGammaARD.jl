if (!Obs[[i]]$action[j]) {
accr[j-1] <- Obs[[i]]$obs[j] - Obs[[i]]$obs[j-1]
} else {
accr[j-1] <- Obs[[i]]$obs[j] - (1-rho)*Obs[[i]]$obs[j-1]
}
}
aux <- data.frame(tps1, tps2, accr)
AccrObs <- rbind(AccrObs, aux)
