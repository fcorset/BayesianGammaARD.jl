Id <- vector(mode = "character", length = nrow(Tab.UPPA))
for (i in 1:nrow(Tab.UPPA)) {
idx <- which(ReasonEN == Tab.UPPA[i, 1])
Tab.UPPA[i, 1] <- ReasonEN[idx, 2]
Categ.Reasons[i] <- as.character(ReasonEN[idx, 3])
Id[i] <- as.character(ReasonEN[idx, 4])
}
Tab.UPPA <- cbind.data.frame(Tab.UPPA, Categ.Reasons, Id)
Mean.Rel.Occ.UPPA <- mean(Rel.Occ.UPPA)
Mean.Rang.UPPA <- mean(RangMoyen.UPPA)
