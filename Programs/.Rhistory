alpha <- 1
beta <- 1/2
b <- 1
rho <- 0.2
tau <- 1
L <- 5
M <- 10
tps.final <- 100
pas <- 0.01
parms <- c(alpha, 1, b, rho)
set.seed(123)
B <- 1000
vparms <- NULL
D <- simu1(alpha, beta, b, rho, tau, L, M, tps.final, pas)
plot1(D$obs, D$GammaNM, D$GammaM)
tps <- seq(from = 0, by = tau, to = tps.final)
obs <- D$obs
DeltaImperf <- ((L <= obs) & (obs < M))
DeltaPerf <- (obs >= M)
sum(DeltaImperf)
sum(DeltaPerf)
