anti <- function(n, fun) {
Ux <- runif(n = n, min = 0, max = 1)
Uy <- runif(n = n, min = 0, max = 1)
fu1 <- fun(Ux, Uy)
fu2 <- fun(1-Ux, Uy)
fu3 <- fun(Ux, 1-Uy)
fu4 <- fun(1-Ux, 1-Uy)
I <- mean(c(fu1,fu2,fu3,fu4))
return(I)
}
