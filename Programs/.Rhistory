methode1 <- function(n, a) {
U <- runif(n = n, min = 0, max = 1)
res <- mean(f(U, a))
return(res)
}
methode1(n, a)
methode2 <- function(n, a) {
X <- runif(n = n, min = 0, max = 1)
Y <- runif(n = n, min = 0, max = 1/4)
res <- mean(f(X, a) <= Y)/4
return(res)
}
methode2(n, a)
methode3 <- function(n, a) {
U <- runif(n = n, min = 0, max = 1)
res <- mean(c(f(U, a),f(1-U, a)))
return(res)
}
methode3(n, a)
n.set <- c(100, 500, 1000, 10000)
a.set <- c(1, 10, 50, 100)
Comparaison <- array(dim = c(length(n.set), length(a.set), 3))
for (i in 1:length(n.set)) {
for (j in 1:length(a.set)) {
Comparaison[i, j, 1] <- methode1(n = n.set[i], a = a.set[j])
Comparaison[i, j, 2] <- methode2(n = n.set[i], a = a.set[j])
Comparaison[i, j, 3] <- methode3(n = n.set[i], a = a.set[j])
}
}
