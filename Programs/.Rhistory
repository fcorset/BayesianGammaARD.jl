Integralerejet <- function(xmin = 0, xmax = 1, ymin = 0, ymax = 1, n, fun){
Ux <- runif(n = n, min = xmin, max = xmax)
Uy <- runif(n = n, min = xmin, max = xmax)
Y <- runif(n = n, min = ymin, max = ymax)
sousint <- (Y - f(Ux,Uy) <= 0)
invisible(list(value = (xmax-xmin)*(ymax-ymin) * mean(sousint), points = sousint, X = Ux, Y = Uy, Z = Y))
}
res <- Integralerejet(n = 1e6, fun = f)
res$value
