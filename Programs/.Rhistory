Occ.UPPA <- c(Occ.UPPA, length(idx))
RangMoyen.UPPA <- c(RangMoyen.UPPA, mean(Rang[idx]))
}
Rel.Occ.UPPA <- Occ.UPPA/sum(Occ.UPPA)
