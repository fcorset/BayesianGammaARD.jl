Integralerejetdec <- function(decoupage, n, fun){
sousint <- c()
for (i in 1:dim(decoupage)[1]){
Ux <- runif(n = n, min = decoupage[i,1], max = decoupage[i,2])
Uy <- runif(n = n, min = decoupage[i,3], max = decoupage[i,4])
Y <- runif(n = n, min = min(decoupage), max = max(decoupage))
sousint <- cbind(sousint,(Y - f(Ux,Uy) <= 0))
}
return(mean(sousint))
}
